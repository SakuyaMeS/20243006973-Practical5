<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/color_default_background">

    <TextView
        android:id="@+id/municipalityName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Municipality"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_dark"
        android:gravity="center"
        android:padding="12dp" />

    <ImageView
        android:id="@+id/municipalityImage"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:src="@drawable/chinese_municipalities"
        android:contentDescription="Municipality image"
        android:scaleType="centerCrop"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/municipalityInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Municipality information"
            android:textSize="16sp"
            android:textColor="@color/color_text_dark"
            android:lineSpacingExtra="4dp"
            android:padding="12dp" />

    </ScrollView>

    <Button
        android:id="@+id/visitSiteButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Visit site"
        android:textAllCaps="false"
        android:layout_marginTop="12dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/color_default_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Municipalities in China"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="@color/color_text_dark"
        android:layout_marginBottom="24dp" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:src="@drawable/chinese_municipalities"
        android:contentDescription="Chinese municipalities"
        android:scaleType="fitCenter"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="I want to know about:"
        android:textSize="18sp"
        android:textColor="@color/color_text_dark" />

    <EditText
        android:id="@+id/editMunicipality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter a municipality"
        android:inputType="text"
        android:maxLines="1"
        android:imeOptions="actionGo" />

</LinearLayout>
